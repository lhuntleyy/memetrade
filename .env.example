# Dev: copy ke .env (chmod 600). Prod: /etc/memebot/secrets.env (owner memebot, chmod 600).
DATABASE_URL=postgres://memebot:CHANGE_ME@127.0.0.1:5432/memebot
DATABASE_URL_RO=postgres://memebot_ro:CHANGE_ME@127.0.0.1:5432/memebot

# Kontrol & dashboard
CONTROL_SECRET=
DASHBOARD_PORT=3000
CORE_CONTROL_PORT=7071

# Provider (diisi saat fase terkait)
HELIUS_API_KEY=
JUPITER_API_KEY=
GMGN_API_KEY=
PUMPPORTAL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
ANTHROPIC_API_KEY=

# Wallet bot (Fase 5 — JANGAN diisi sebelum go-live disetujui)
WALLET_PRIVATE_KEY=
