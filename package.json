{
  "name": "memebot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate": "bun run apps/cli/src/main.ts migrate",
    "config:check": "bun run apps/cli/src/main.ts config:check",
    "dev:core": "bun --watch run apps/core/src/main.ts",
    "dev:dashboard": "bun --hot run apps/dashboard/src/server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
