[Unit]
Description=memebot core trading engine
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=memebot
Group=memebot
WorkingDirectory=/opt/memebot/app
EnvironmentFile=/etc/memebot/secrets.env
Environment=NODE_ENV=production
Environment=MEMEBOT_CONFIG_DIR=/opt/memebot/app/config
ExecStart=/opt/memebot/.bun/bin/bun run apps/core/src/main.ts
Restart=always
RestartSec=3
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/memebot /run/memebot
ReadOnlyPaths=/opt/memebot/app

[Install]
WantedBy=multi-user.target
